# ─────────────────────────────────────────────────────────────────
# SupportIQ — Environment Variables Template
# Copy this file to `.env` and fill in your actual values.
# DO NOT commit the real `.env` file to version control.
# ─────────────────────────────────────────────────────────────────

# Swytchcode API credentials
SWYTCHCODE_API_KEY=your_swytchcode_api_key_here
SWYTCHCODE_BASE_URL=https://api.swytchcode.com
SWYTCHCODE_MCP_URL=
SWYTCHCODE_MODE=MOCK_DIRECT   # Options: SWYTCHCODE_SDK | SWYTCHCODE_MCP | SWYTCHCODE_REST | MOCK_DIRECT

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Internal mock API URLs
ECOMMERCE_API_URL=http://localhost:8001
SUPPORT_API_URL=http://localhost:8002

# Database (Supabase or PostgreSQL)
DATABASE_URL=your_supabase_connection_string_here

# App
ENVIRONMENT=development
SECRET_KEY=change_me_to_a_random_32_char_string
